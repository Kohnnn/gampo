{
    "name": "gampo-educational-simulator",
    "version": "1.0.0",
    "description": "GamPo fake-credit casino and sportsbook probability simulator",
    "type": "module",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "smoke:browser": "node --experimental-websocket scripts/browserSmoke.mjs",
        "ux:benchmark": "node --experimental-websocket scripts/browserSmoke.mjs --mode=ux --out=output/ux-benchmark",
        "verify:betsheet": "node --experimental-websocket scripts/verifyBetSheet.mjs",
        "audit:a11y": "node --experimental-websocket scripts/auditA11y.mjs",
        "audit:contrast": "node --experimental-websocket scripts/auditContrast.mjs",
        "audit:scroll": "node scripts/auditPlayfieldOverflow.mjs",
        "audit:all": "npm run audit:a11y && npm run audit:contrast && npm run audit:scroll && npm run verify:betsheet",
        "gen:assets": "node scripts/genAssets.js"
    },
    "dependencies": {
        "chart.js": "^4.5.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "framer-motion": "^12.39.0",
        "lucide-react": "^0.575.0",
        "pokersolver": "^2.1.4",
        "radix-ui": "^1.4.3",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-router-dom": "^6.20.0",
        "tailwind-merge": "^3.5.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.2.1",
        "@types/node": "^25.3.0",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@vitejs/plugin-react": "^5.2.0",
        "autoprefixer": "^10.4.24",
        "postcss": "^8.5.6",
        "shadcn": "^3.8.5",
        "tailwindcss": "^4.2.1",
        "tw-animate-css": "^1.4.0",
        "vite": "^7.3.5",
        "vitest": "^4.1.8"
    }
}
